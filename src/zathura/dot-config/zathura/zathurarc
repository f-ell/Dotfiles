set dbus-service 'false'
set selection-notification 'false'
set window-title-basename 'true'
set window-title-home-tilde 'true'
set statusbar-basename 'true'

set font 'Ellograph CF 10'
set page-h-padding 4
set page-v-padding 4
set show-recent 4
set scroll-step 60
set scroll-page-aware 'true'
set search-hadjust 'false'

# set recolor
set recolor-keephue

set statusbar-h-padding 10
set statusbar-v-padding  4

set window-height 600
set window-width  800

#############################

set default-fg              '#3c464b'
set default-bg              '#eae7d7'

set inputbar-fg             '#3c464b'
set inputbar-bg             '#e3ded0'

set statusbar-fg            '#3c464b'
set statusbar-bg            '#e3ded0'

set notification-fg         '#3c464b'
set notification-bg         '#8da101'
set notification-warning-fg '#3c464b'
set notification-warning-bg '#dfa000'
set notification-error-fg   '#3c464b'
set notification-error-bg   '#f85552'

set index-fg                '#3c464b'
set index-bg                '#f8f5e4'
set index-active-fg         '#3c464b'
set index-active-bg         '#8da101'

set completion-fg           '#3c464b'
set completion-bg           '#f8f5e4'
set completion-group-fg     '#df69ba'
set completion-group-bg     '#fffbef'
set completion-highlight-fg '#3c464b'
set completion-highlight-bg '#8da101'

set recolor-lightcolor      '#f2efdf'
set recolor-darkcolor       '#191b1d'

set highlight-fg            '#f2efdf'
set highlight-color         'rgba(58, 148, 197, 0.7)'
set highlight-active-color  'rgba(223, 105, 186, 0.7)'

map <C-l> nohlsearch
